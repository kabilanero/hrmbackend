// Prisma schema for the HRM platform (PostgreSQL on Supabase).
// - DATABASE_URL : pooled connection (pgbouncer / Supavisor) used at runtime
// - DIRECT_URL   : direct connection used by `prisma migrate`

generator client {
  provider   = "prisma-client-js"
  // Rust-free client: no native query-engine binary; queries run through the `pg`
  // driver adapter (see PrismaService). Smaller image, works with Supabase pooler.
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEK_OFF
}

// ───────────────────────────── Security ─────────────────────────────

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique // ADMIN | HR | MANAGER | EMPLOYEE (extensible)
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserAccount[]

  @@map("roles")
}

/// Application profile of a Supabase Auth user. `id` equals `auth.users.id`.
model UserAccount {
  id          String    @id @db.Uuid
  email       String    @unique
  userName    String?   @unique
  roleId      String    @db.Uuid
  employeeId  String?   @unique @db.Uuid
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  role     Role      @relation(fields: [roleId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([roleId])
  @@map("user_accounts")
}

// ───────────────────────────── Master data ─────────────────────────────

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  email     String?
  phone     String?
  addressLine String?
  city      String?
  state     String?
  country   String?
  pincode   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees        Employee[]       @relation("EmployeeDefaultBranch")
  employeeBranches EmployeeBranch[]

  @@map("branches")
}

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]

  @@map("departments")
}

model Designation {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  level       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]

  @@map("designations")
}

model WorkShift {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  startTime   String // "HH:mm" (24h)
  endTime     String // "HH:mm" (24h)
  durationMin Int // shift duration in minutes
  graceMin    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees Employee[]

  @@map("work_shifts")
}

model BloodGroup {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())

  employees Employee[]

  @@map("blood_groups")
}

model LeaveType {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String   @unique
  maxDaysYear Int      @default(0)
  isPaid      Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leaves LeaveApply[]

  @@map("leave_types")
}

model NationalHoliday {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  date      DateTime @db.Date
  year      Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, name])
  @@index([year])
  @@map("national_holidays")
}

// ───────────────────────────── Employees ─────────────────────────────

model Employee {
  id                String         @id @default(uuid()) @db.Uuid
  employeeCode      String         @unique
  employeeName      String
  fatherName        String?
  gender            Gender?
  maritalStatus     MaritalStatus?
  dateOfBirth       DateTime?      @db.Date
  bloodGroupId      String?        @db.Uuid
  highestQualification String?
  emailId           String         @unique
  secondaryEmailId  String?
  contactNumber     String?
  alterMobileNumber String?
  emergencyContactNumber String?
  profileImagePath  String?

  // Company information
  dateOfJoining     DateTime       @db.Date
  dateOfResign      DateTime?      @db.Date
  departmentId      String?        @db.Uuid
  designationId     String?        @db.Uuid
  defaultBranchId   String?        @db.Uuid
  workShiftId       String?        @db.Uuid
  reportsToId       String?        @db.Uuid
  isDepartmentHead  Boolean        @default(false)
  isTravelTrackable Boolean        @default(false)
  basicPay          Decimal?       @db.Decimal(12, 2)
  pfUANNo           String?
  esiRefNo          String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bloodGroup    BloodGroup?  @relation(fields: [bloodGroupId], references: [id], onDelete: SetNull)
  department    Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation   Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  defaultBranch Branch?      @relation("EmployeeDefaultBranch", fields: [defaultBranchId], references: [id], onDelete: SetNull)
  workShift     WorkShift?   @relation(fields: [workShiftId], references: [id], onDelete: SetNull)
  reportsTo     Employee?    @relation("EmployeeHierarchy", fields: [reportsToId], references: [id], onDelete: SetNull)
  reportees     Employee[]   @relation("EmployeeHierarchy")

  branches    EmployeeBranch[]
  addresses   EmployeeAddress[]
  bankAccounts BankAccount[]
  attendances Attendance[]
  leaves      LeaveApply[]     @relation("LeaveApplicant")
  approvals   LeaveApply[]     @relation("LeaveApprover")
  userAccount UserAccount?

  @@index([departmentId])
  @@index([designationId])
  @@index([reportsToId])
  @@index([isActive])
  @@map("employees")
}

model EmployeeBranch {
  employeeId String @db.Uuid
  branchId   String @db.Uuid

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([employeeId, branchId])
  @@map("employee_branches")
}

model EmployeeAddress {
  id          String   @id @default(uuid()) @db.Uuid
  employeeId  String   @db.Uuid
  type        String   @default("CURRENT") // CURRENT | PERMANENT
  addressLine String
  city        String?
  district    String?
  state       String?
  country     String?
  pincode     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_addresses")
}

model BankAccount {
  id            String   @id @default(uuid()) @db.Uuid
  employeeId    String   @db.Uuid
  bankName      String
  accountNumber String
  ifscCode      String
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, accountNumber])
  @@map("bank_accounts")
}

// ───────────────────────────── Leave & attendance ─────────────────────────────

model LeaveApply {
  id          String      @id @default(uuid()) @db.Uuid
  employeeId  String      @db.Uuid
  leaveTypeId String      @db.Uuid
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  noOfDays    Decimal     @db.Decimal(5, 1)
  reason      String
  status      LeaveStatus @default(PENDING)
  approverId  String?     @db.Uuid
  approvedAt  DateTime?
  remarks     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  employee  Employee  @relation("LeaveApplicant", fields: [employeeId], references: [id], onDelete: Cascade)
  approver  Employee? @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([employeeId, status])
  @@index([startDate, endDate])
  @@map("leave_applications")
}

model Attendance {
  id           String           @id @default(uuid()) @db.Uuid
  employeeId   String           @db.Uuid
  date         DateTime         @db.Date
  punchIn      DateTime?
  punchOut     DateTime?
  workedMinutes Int             @default(0)
  status       AttendanceStatus @default(PRESENT)
  remarks      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([date])
  @@map("attendances")
}
